# COPY TO .env IN REPOSITORY ROOT. NEVER COMMIT THE REAL .env.
# Generate 3 DIFFERENT random secrets (PowerShell):
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_NEW_RANDOM_JWT_SECRET_AT_LEAST_24_CHARS
INTERNAL_API_KEY=REPLACE_WITH_NEW_RANDOM_INTERNAL_KEY_AT_LEAST_24_CHARS
TURN_SECRET=REPLACE_WITH_NEW_RANDOM_TURN_SECRET_AT_LEAST_24_CHARS

ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD

# TURN_HOST must be resolvable/reachable by the BROWSER, not a Docker service name.
# For local same-PC demo, set to the Windows LAN IPv4 address (ipconfig), e.g. 192.168.1.50.
# For a VPS, use a public IP or hostname with UDP port-forward/firewall open.
TURN_HOST=REPLACE_WITH_REACHABLE_HOST_OR_IP
# External IP of the Docker HOST to advertise as coturn relay IP (usually same numeric IPv4 as TURN_HOST).
TURN_EXTERNAL_IP=REPLACE_WITH_HOST_IPV4
TURN_REALM=webrtc-demo.local
TURN_TTL=3600
TURN_TLS_ENABLED=false

# Browser URL for local HTTPS: https://localhost:8443
HTTP_PORT=8080
HTTPS_PORT=8443
