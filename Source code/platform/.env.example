# Copy to .env and replace every example secret; use the SAME JWT_SECRET in realtime/.env.
PLATFORM_PORT=3000
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_JWT_SECRET
INTERNAL_API_KEY=REPLACE_WITH_LONG_RANDOM_INTERNAL_KEY
REALTIME_URL=http://127.0.0.1:3001
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
# For TURN: set TURN_HOST and TURN_SECRET shared with coturn's static-auth-secret.
TURN_HOST=
TURN_SECRET=
TURN_TTL=3600
# Keep false for local Vite development. true only behind a trusted Nginx ingress.
TRUST_PROXY=false
NODE_ENV=development
