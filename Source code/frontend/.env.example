# ---- used by `npm run dev` (Vite proxy targets) ----
DEV_API_TARGET=http://localhost:3000   # platform (Member 3) REST
DEV_WS_TARGET=http://localhost:3001    # realtime (Member 2) WebSocket

# ---- used by `docker compose up` in this folder (all optional, defaults shown) ----
FRONTEND_PORT=8080
USE_MOCK_API=false
API_UPSTREAM=http://host.docker.internal:3000
WS_UPSTREAM=http://host.docker.internal:3001
USE_MOCK_ADMIN=false      # Administrator pages: true = fake data, false = real /admin/* and /api/admin/users
