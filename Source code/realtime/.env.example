PORT=3001
JWT_SECRET=REPLACE_WITH_THE_PLATFORM_JWT_SECRET
INTERNAL_API_KEY=REPLACE_WITH_THE_PLATFORM_INTERNAL_API_KEY_MINIMUM_24_CHARACTERS
PLATFORM_URL=http://host.docker.internal:3000
NODE_ENV=development

# These TURN values must match the platform configuration.
TURN_HOST=REPLACE_WITH_PUBLIC_TURN_HOST
TURN_SECRET=REPLACE_WITH_THE_PLATFORM_TURN_SECRET
TURN_TTL=3600
TURN_REALM=REPLACE_WITH_TURN_REALM
# Optional in development; required in production and must be the TURN server's public IP.
TURN_EXTERNAL_IP=

# Real internet STUN/TURN tests require a public server and TURN_EXTERNAL_IP set to its public IP.
